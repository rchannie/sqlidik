# Salin file ini menjadi .env untuk menjalankan server di laptop.

# Kosongkan supaya memakai SQLite (file sqlidik.db). Untuk Supabase, isi dengan alamat Session pooler.
DATABASE_URL=

# Kunci rahasia untuk token login. Isi dengan teks acak yang panjang.
JWT_SECRET=ganti-dengan-teks-acak-yang-panjang

# Kode yang harus dimasukkan guru saat mendaftar. Kosongkan untuk menutup pendaftaran guru.
KODE_DAFTAR_GURU=sqlidik-guru-2026

# Alamat yang boleh memanggil API. Tanda * berarti semua alamat.
CORS_ORIGINS=*
